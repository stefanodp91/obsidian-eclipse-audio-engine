{
  "name": "obsidian-eclipse-audio-engine",
  "version": "0.1.0",
  "description": "Independent game audio engine: one behaviour on Web Audio, Android and iOS, with the machinery in the library and the content in the game.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanodp91/obsidian-eclipse-audio-engine.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/stefanodp91/obsidian-eclipse-audio-engine/tree/main/packages/core#readme",
  "bugs": { "url": "https://github.com/stefanodp91/obsidian-eclipse-audio-engine/issues" },
  "publishConfig": { "access": "public" },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:dry-run": "npm pack --dry-run"
  },
  "devDependencies": {
    "typescript": "^5.4.3",
    "vite": "^7.1.3",
    "vitest": "^3.0.0"
  }
}
